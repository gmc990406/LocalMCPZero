<UserControl x:Class="ZERO.GovernanceWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource UiFont}"
             UseLayoutRounding="True" SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType">
    <UserControl.Resources>

        <!-- 通用列表项：标题 + 说明（候选、任务、结论） -->
        <DataTemplate x:Key="ItemTemplate">
            <StackPanel>
                <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding Meta}" FontSize="11.5" Foreground="{StaticResource TextSecondary}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="MemTemplate">
            <StackPanel>
                <TextBlock Text="{Binding FirstLine}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding Meta}" FontSize="11.5" Foreground="{StaticResource TextSecondary}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="LineTemplate">
            <TextBlock Text="{Binding Line}" FontSize="11.5" FontFamily="{StaticResource MonoFont}" TextWrapping="Wrap"/>
        </DataTemplate>
    </UserControl.Resources>
<Grid Margin="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid x:Name="PageHead" Grid.Row="0" Margin="0,0,0,14">
                    <TextBlock x:Name="PageTitle" Text="治理中心" FontWeight="SemiBold"
                               FontSize="{DynamicResource PageTitleFontSize}" VerticalAlignment="Center"/>
                </Grid>


                <!-- ========== 页签 ========== -->
                <Grid Grid.Row="1" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Background="#E9E9EE" CornerRadius="8">
                        <StackPanel x:Name="TabBar" Orientation="Horizontal">
                            <RadioButton Style="{StaticResource Segment}" GroupName="GovTab" Content="概览" Tag="overview" IsChecked="True" Click="Tab_Click"/>
                            <RadioButton x:Name="TabReview" Style="{StaticResource Segment}" GroupName="GovTab" Content="记忆治理" Tag="review" Click="Tab_Click"/>
                            <RadioButton x:Name="TabTasks" Style="{StaticResource Segment}" GroupName="GovTab" Content="任务中心" Tag="tasks" Click="Tab_Click"/>
                            <RadioButton Style="{StaticResource Segment}" GroupName="GovTab" Content="审核与回收站" Tag="audit" Click="Tab_Click"/>
                            <RadioButton Style="{StaticResource Segment}" GroupName="GovTab" Content="策略设置" Tag="policy" Click="Tab_Click"/>
                        </StackPanel>
                    </Border>
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button x:Name="BtnScan" Style="{StaticResource PrimaryButton}" Padding="14,7" Click="Scan_Click"
                                ToolTip="用确定性规则检查记忆库（重复、冲突、过期、长期未用等），不调用任何 AI 模型">
                            <TextBlock x:Name="ScanText" Text="立即检查记忆库" Foreground="White" FontWeight="SemiBold"/>
                        </Button>
                        <Button Style="{StaticResource IconButton}" ToolTip="刷新" Margin="8,0,0,0" Click="Refresh_Click">
                            <Path Style="{StaticResource IconPresenter}" Data="{StaticResource Icon.Refresh}"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="2">
                    <!-- ========== 概览 ========== -->
                    <ScrollViewer x:Name="PanelOverview" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <StackPanel x:Name="StatHost" Margin="0,0,0,6"/>
                            <Border Style="{StaticResource Card}" Padding="20,16" Margin="0,8,0,0">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Caption}" Text="记忆库检查"/>
                                    <TextBlock x:Name="ScanInfo" FontSize="12.5" TextWrapping="Wrap" LineHeight="20" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Padding="20,16" Margin="0,12,0,0">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Caption}" Text="当前策略"/>
                                    <TextBlock x:Name="PolicyInfo" FontSize="12.5" TextWrapping="Wrap" LineHeight="20" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Padding="20,16" Margin="0,12,0,0">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Caption}" Text="工作方式"/>
                                    <TextBlock FontSize="12.5" TextWrapping="Wrap" LineHeight="20" Margin="0,6,0,0" Foreground="{StaticResource TextSecondary}"
                                               Text="① ZERO 定期用确定性规则检查记忆库（不调用模型、不花钱），把可能重复、冲突、过期、长期未用的记忆列为「候选」，并生成维护任务。&#x0a;② 连接的 AI 空闲时可以领取任务（governance_claim），阅读候选后提交结构化结论；同一任务同一时刻只会被一个 AI 领取，超时自动回到队列。&#x0a;③ 低风险结论（如保留、降权）按策略自动生效；合并、压缩、更正、归档、删除等需要你在「记忆治理」中批准。&#x0a;④ 每次修改都保留历史版本，删除先进入回收站，都可以在「审核与回收站」中恢复。你也可以不等 AI，直接处理候选。"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ========== 记忆治理 ========== -->
                    <Grid x:Name="PanelReview" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="ListCol320" Width="300"/>
                            <ColumnDefinition x:Name="ListGap320" Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Card}" Padding="8,12,4,8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border Background="#E9E9EE" CornerRadius="8" Margin="8,0,8,8" HorizontalAlignment="Stretch">
                                    <UniformGrid x:Name="CandFilter" Columns="3">
                                        <RadioButton Style="{StaticResource SegmentDense}" GroupName="CandF" Content="待处理" Tag="open" IsChecked="True" Click="CandFilter_Click"/>
                                        <RadioButton Style="{StaticResource SegmentDense}" GroupName="CandF" Content="已关闭" Tag="closed" Click="CandFilter_Click"/>
                                        <RadioButton Style="{StaticResource SegmentDense}" GroupName="CandF" Content="待审批结论" Tag="decisions" Click="CandFilter_Click"/>
                                    </UniformGrid>
                                </Border>
                                <ListBox x:Name="CandList" Grid.Row="1" Style="{StaticResource PlainList}" ItemTemplate="{StaticResource ItemTemplate}"
                                         SelectionChanged="CandList_SelectionChanged"/>
                                <TextBlock x:Name="CandEmpty" Grid.Row="1" TextAlignment="Center" FontSize="12.5" LineHeight="20" Foreground="{StaticResource TextTertiary}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20,16,16,16">
                            <Grid>
                                <ScrollViewer x:Name="CandDetailScroll" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                                    <StackPanel x:Name="CandDetail"/>
                                </ScrollViewer>
                                <TextBlock x:Name="CandDetailEmpty" Text="选择左侧的一个候选查看详情和处理" TextAlignment="Center" FontSize="12.5"
                                           Foreground="{StaticResource TextTertiary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- ========== 任务中心 ========== -->
                    <Grid x:Name="PanelTasks" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="ListCol340" Width="300"/>
                            <ColumnDefinition x:Name="ListGap340" Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Card}" Padding="8,12,4,8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border Background="#E9E9EE" CornerRadius="8" Margin="8,0,8,8" HorizontalAlignment="Stretch">
                                    <UniformGrid x:Name="TaskFilter" Columns="4">
                                        <RadioButton Style="{StaticResource SegmentDense}" GroupName="TaskF" Content="进行中" Tag="active" IsChecked="True" Click="TaskFilter_Click"/>
                                        <RadioButton Style="{StaticResource SegmentDense}" GroupName="TaskF" Content="需要关注" Tag="attention" Click="TaskFilter_Click"/>
                                        <RadioButton Style="{StaticResource SegmentDense}" GroupName="TaskF" Content="已结束" Tag="done" Click="TaskFilter_Click"/>
                                        <RadioButton Style="{StaticResource SegmentDense}" GroupName="TaskF" Content="全部" Tag="all" Click="TaskFilter_Click"/>
                                    </UniformGrid>
                                </Border>
                                <ListBox x:Name="TaskList" Grid.Row="1" Style="{StaticResource PlainList}" ItemTemplate="{StaticResource ItemTemplate}"
                                         SelectionChanged="TaskList_SelectionChanged"/>
                                <TextBlock x:Name="TaskEmpty" Grid.Row="1" TextAlignment="Center" FontSize="12.5" LineHeight="20" Foreground="{StaticResource TextTertiary}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20,16,16,16">
                            <Grid>
                                <Grid x:Name="TaskDetail" Visibility="Collapsed">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock x:Name="TaskTitle" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBox x:Name="TaskInfo" Grid.Row="1" Style="{StaticResource CodeBox}" IsReadOnly="True" TextWrapping="Wrap" Margin="0,10,0,0" MaxHeight="220"
                                             VerticalScrollBarVisibility="Auto"/>
                                    <WrapPanel x:Name="TaskButtons" Grid.Row="2" Margin="0,12,0,0"/>
                                    <TextBlock Grid.Row="3" Style="{StaticResource Caption}" Text="事件（新→旧）" Margin="2,14,0,6"/>
                                    <ListBox x:Name="TaskEvents" Grid.Row="4" Style="{StaticResource PlainList}" ItemTemplate="{StaticResource LineTemplate}"/>
                                </Grid>
                                <TextBlock x:Name="TaskDetailEmpty" Text="选择左侧的一个任务查看进度&#x0a;AI 用 task_create 登记的计划、记忆维护任务都会显示在这里" TextAlignment="Center"
                                           FontSize="12.5" LineHeight="20" Foreground="{StaticResource TextTertiary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- ========== 审核与回收站 ========== -->
                    <Grid x:Name="PanelAudit" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Background="#E9E9EE" CornerRadius="8" HorizontalAlignment="Left" Margin="0,0,0,12">
                            <UniformGrid x:Name="AuditFilter" Columns="3">
                                <RadioButton Style="{StaticResource SegmentDense}" GroupName="AudF" Content="回收站" Tag="trash" IsChecked="True" Click="AuditFilter_Click"/>
                                <RadioButton Style="{StaticResource SegmentDense}" GroupName="AudF" Content="全部记忆" Tag="all" Click="AuditFilter_Click"/>
                                <RadioButton Style="{StaticResource SegmentDense}" GroupName="AudF" Content="审计日志" Tag="log" Click="AuditFilter_Click"/>
                            </UniformGrid>
                        </Border>

                        <Grid x:Name="AuditMasterDetail" Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="ListCol300" Width="300"/>
                                <ColumnDefinition x:Name="ListGap300" Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource Card}" Padding="8,12,4,8">
                                <Grid>
                                    <ListBox x:Name="AuditList" Style="{StaticResource PlainList}" ItemTemplate="{StaticResource MemTemplate}"
                                             SelectionChanged="AuditList_SelectionChanged"/>
                                    <TextBlock x:Name="AuditEmpty" TextAlignment="Center" FontSize="12.5" LineHeight="20" Foreground="{StaticResource TextTertiary}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                                </Grid>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20,16,16,16">
                                <Grid>
                                    <ScrollViewer x:Name="AuditDetailScroll" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                                        <StackPanel x:Name="AuditDetail"/>
                                    </ScrollViewer>
                                    <TextBlock x:Name="AuditDetailEmpty" Text="选择左侧的一条记忆查看历史版本、恢复或永久删除" TextAlignment="Center" FontSize="12.5"
                                               Foreground="{StaticResource TextTertiary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </Grid>

                        <Border x:Name="AuditLogPane" Grid.Row="1" Style="{StaticResource Card}" Padding="16,14" Visibility="Collapsed">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock x:Name="AuditLogHint" FontSize="12" Foreground="{StaticResource TextSecondary}"
                                           Text="记忆的每次创建、修改、合并、归档、删除、恢复都会记在这里（只追加不修改）。" Margin="0,0,0,10" TextWrapping="Wrap"/>
                                <ListView x:Name="AuditLog" Grid.Row="1" BorderThickness="0" Background="Transparent"
                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                          SizeChanged="AuditLog_SizeChanged">
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="时间" Width="120" DisplayMemberBinding="{Binding TimeText}"/>
                                            <GridViewColumn Header="来源" Width="140" DisplayMemberBinding="{Binding Actor}"/>
                                            <GridViewColumn Header="记忆" Width="70" DisplayMemberBinding="{Binding MemoryRef}"/>
                                            <GridViewColumn Header="操作" Width="120" DisplayMemberBinding="{Binding ActionLabel}"/>
                                            <GridViewColumn x:Name="AuditColVersion" Header="版本变化" Width="110" DisplayMemberBinding="{Binding VersionChange}"/>
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- ========== 策略设置 ========== -->
                    <ScrollViewer x:Name="PanelPolicy" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                        <StackPanel x:Name="PolicyHost"/>
                    </ScrollViewer>
                </Grid>

                <!-- ========== 底部 ========== -->
                <Grid Grid.Row="3" Margin="4,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="FooterHint" FontSize="11.5" Foreground="{StaticResource TextTertiary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <StackPanel x:Name="PolicyButtons" Grid.Column="1" Orientation="Horizontal" Visibility="Collapsed">
                        <Button Style="{StaticResource SecondaryButton}" Content="恢复默认" Margin="0,0,10,0" Click="PolicyReset_Click"/>
                        <Button Style="{StaticResource PrimaryButton}" Padding="16,7" Click="PolicySave_Click">
                            <TextBlock Text="保存策略" Foreground="White" FontWeight="SemiBold"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
</UserControl>
