<UserControl x:Class="ZERO.HistoryWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:local="clr-namespace:ZERO"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource UiFont}"
             UseLayoutRounding="True" SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType">
    <UserControl.Resources>

        <BooleanToVisibilityConverter x:Key="BoolVis"/>

        <!-- 左侧：按对话 -->
        <DataTemplate x:Key="ConvTemplate">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding DisplayTitle}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Untitled}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                                        <Setter Property="FontWeight" Value="Normal"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Path Grid.Column="1" Style="{StaticResource IconPresenter}" Width="12" Height="12" Margin="8,0,0,0"
                          Stroke="{StaticResource Accent}" Data="{StaticResource Icon.Pin}"
                          Visibility="{Binding Pinned, Converter={StaticResource BoolVis}}"/>
                </Grid>
                <TextBlock Text="{Binding Meta}" FontSize="11.5" Foreground="{StaticResource TextSecondary}" Margin="0,3,0,0"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding Summary}" FontSize="11.5" Foreground="{StaticResource TextTertiary}" Margin="0,3,0,0"
                           TextTrimming="CharacterEllipsis" Visibility="{Binding HasSummary, Converter={StaticResource BoolVis}}"/>
            </StackPanel>
        </DataTemplate>

        <!-- 左侧：按工具 -->
        <DataTemplate x:Key="ToolTemplate">
            <StackPanel>
                <TextBlock Text="{Binding Tool}" FontFamily="{StaticResource MonoFont}" FontSize="12.5" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding Meta}" FontSize="11.5" Foreground="{StaticResource TextSecondary}" Margin="0,3,0,0"
                           TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </DataTemplate>

        <Style x:Key="StatusDot" TargetType="Ellipse">
            <Setter Property="Width" Value="7"/>
            <Setter Property="Height" Value="7"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Fill" Value="{StaticResource Green}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Ok}" Value="False"><Setter Property="Fill" Value="{StaticResource Red}"/></DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 右侧调用列表：对话视图（显示工具名） -->
        <DataTemplate x:Key="CallTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Ellipse Style="{StaticResource StatusDot}"/>
                <TextBlock Grid.Column="1" Text="{Binding TimeText}" FontFamily="{StaticResource MonoFont}" FontSize="11.5"
                           Foreground="{StaticResource TextTertiary}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <Border Grid.Column="2" Background="#ECEEF3" CornerRadius="5" Padding="7,2" Margin="0,0,10,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Tool}" FontFamily="{StaticResource MonoFont}" FontSize="11.5"/>
                </Border>
                <TextBlock Grid.Column="3" Text="{Binding Preview}" FontFamily="{StaticResource MonoFont}" FontSize="11.5"
                           Foreground="{StaticResource TextSecondary}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                <Path Grid.Column="4" Style="{StaticResource IconPresenter}" Width="11" Height="11" Margin="8,0,0,0" Stroke="{StaticResource Orange}"
                      Data="{StaticResource Icon.Info}" ToolTip="有备注" Visibility="{Binding HasNote, Converter={StaticResource BoolVis}}"/>
            </Grid>
        </DataTemplate>

        <!-- 右侧调用列表：工具视图（显示所在对话） -->
        <DataTemplate x:Key="CallToolTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Ellipse Style="{StaticResource StatusDot}" VerticalAlignment="Top" Margin="0,5,10,0"/>
                <TextBlock Grid.Column="1" Text="{Binding TimeText}" FontFamily="{StaticResource MonoFont}" FontSize="11.5"
                           Foreground="{StaticResource TextTertiary}" Margin="0,1,10,0"/>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="{Binding Context}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Preview}" FontFamily="{StaticResource MonoFont}" FontSize="11.5" Margin="0,2,0,0"
                               Foreground="{StaticResource TextSecondary}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>
<Grid Margin="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid x:Name="PageHead" Grid.Row="0" Margin="0,0,0,14">
                    <TextBlock x:Name="PageTitle" Text="历史记录" FontWeight="SemiBold"
                               FontSize="{DynamicResource PageTitleFontSize}" VerticalAlignment="Center"/>
                </Grid>


                <!-- ========== 工具栏 ========== -->
                <Grid Grid.Row="1" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Background="#E9E9EE" CornerRadius="8" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="ViewConv" Style="{StaticResource Segment}" GroupName="View" Content="按对话" IsChecked="True"
                                         Checked="View_Changed"/>
                            <RadioButton x:Name="ViewTool" Style="{StaticResource Segment}" GroupName="View" Content="按工具"
                                         Checked="View_Changed"/>
                        </StackPanel>
                    </Border>
                    <local:SearchBar x:Name="Search" Grid.Column="1" Margin="14,0,0,0"
                                     Hint="搜索标题、摘要、命令、文件、结果…"
                                     SearchRequested="Search_Go" Cleared="Search_Go"/>
                    <Button Grid.Column="2" Style="{StaticResource IconButton}" ToolTip="刷新" Click="Refresh_Click">
                        <Path Style="{StaticResource IconPresenter}" Data="{StaticResource Icon.Refresh}"/>
                    </Button>
                </Grid>

                <!-- ========== 主体 ========== -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="ListCol" Width="300"/>
                        <ColumnDefinition x:Name="ListGap" Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 左侧列表 -->
                    <Border Style="{StaticResource Card}" Padding="8,12,4,8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="ListTitle" Style="{StaticResource Caption}" Text="对话" Margin="12,0,0,8"/>
                            <ListBox x:Name="MainList" Grid.Row="1" Style="{StaticResource PlainList}" SelectionChanged="MainList_SelectionChanged"
                                     ItemTemplate="{StaticResource ConvTemplate}"/>
                            <TextBlock x:Name="ListEmpty" Grid.Row="1" Text="还没有历史记录&#x0a;AI 操作这台电脑后会自动记录在这里" TextAlignment="Center"
                                       FontSize="12.5" LineHeight="20" Foreground="{StaticResource TextTertiary}" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" Visibility="Collapsed"/>
                        </Grid>
                    </Border>

                    <!-- 右侧详情 -->
                    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20,16,16,16">
                        <Grid>
                            <Grid x:Name="Detail" Visibility="Collapsed">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*" MinHeight="120"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- 标题行 -->
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBox x:Name="TitleEdit" Style="{StaticResource EditBox}" FontSize="16" FontWeight="SemiBold"
                                                 Background="Transparent" Padding="9,5" ToolTip="点击编辑标题" MaxLength="200" LostKeyboardFocus="ConvEdit_LostFocus" KeyDown="TitleEdit_KeyDown"/>
                                        <TextBlock x:Name="ToolTitle" FontFamily="{StaticResource MonoFont}" FontSize="16" FontWeight="SemiBold"
                                                   Margin="0,4,0,0" Visibility="Collapsed"/>
                                        <TextBlock x:Name="MetaText" FontSize="11.5" Foreground="{StaticResource TextSecondary}" Margin="10,2,0,0"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <StackPanel x:Name="ConvActions" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="10,2,0,0">
                                        <Button x:Name="BtnMerge" Style="{StaticResource SecondaryButton}" Content="合并到上一组" Margin="0,0,6,0"
                                                ToolTip="把这一组并入同一客户端的上一组（同一个聊天被误拆开时使用）" Click="Merge_Click"/>
                                        <Button x:Name="BtnPin" Style="{StaticResource IconButton}" ToolTip="置顶（不会被自动清理）" Click="Pin_Click">
                                            <Path x:Name="PinIcon" Style="{StaticResource IconPresenter}" Data="{StaticResource Icon.Pin}"/>
                                        </Button>
                                        <Button Style="{StaticResource IconButton}" ToolTip="删除对话" Click="DeleteConv_Click">
                                            <Path Style="{StaticResource IconPresenter}" Data="{StaticResource Icon.Trash}"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <!-- 摘要 -->
                                <StackPanel x:Name="SummaryPanel" Grid.Row="1" Margin="0,12,0,0">
                                    <TextBlock Style="{StaticResource Caption}" Text="摘要（AI 查看历史时会读到）" Margin="2,0,0,6"/>
                                    <TextBox x:Name="SummaryEdit" Style="{StaticResource EditBox}" Height="62" AcceptsReturn="True" TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto" MaxLength="4000" LostKeyboardFocus="ConvEdit_LostFocus"/>
                                </StackPanel>

                                <Grid Grid.Row="2" Margin="2,14,0,6">
                                    <TextBlock x:Name="CallsTitle" Style="{StaticResource Caption}" Text="操作记录"/>
                                    <TextBlock x:Name="SavedTip" Text="已保存" FontSize="11.5" Foreground="{StaticResource Green}"
                                               HorizontalAlignment="Right" Opacity="0"/>
                                </Grid>

                                <ListBox x:Name="CallList" Grid.Row="3" Style="{StaticResource PlainList}" ItemTemplate="{StaticResource CallTemplate}"
                                         SelectionChanged="CallList_SelectionChanged"/>

                                <!-- 选中记录的详情 -->
                                <Border x:Name="CallDetail" Grid.Row="4" BorderBrush="{StaticResource CardBorder}" BorderThickness="0,1,0,0"
                                        Margin="0,8,0,0" Padding="0,10,0,0" Visibility="Collapsed">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Ellipse x:Name="CallDot" Width="8" Height="8" Margin="2,0,8,0"/>
                                                <TextBlock x:Name="CallHead" FontSize="12.5" FontWeight="SemiBold"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <Button x:Name="BtnGoConv" Style="{StaticResource SecondaryButton}" Content="查看所在对话" Margin="0,0,8,0"
                                                        Click="GoConv_Click"/>
                                                <Button x:Name="BtnSplit" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="Split_Click"
                                                        ToolTip="把这条及之后的记录拆分为一个新对话">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Style="{StaticResource IconPresenter}" Width="12" Height="12" Margin="0,0,6,0" Data="{StaticResource Icon.Split}"/>
                                                        <TextBlock Text="从这里拆分"/>
                                                    </StackPanel>
                                                </Button>
                                                <Button Style="{StaticResource IconButton}" ToolTip="删除这条记录" Click="DeleteCall_Click">
                                                    <Path Style="{StaticResource IconPresenter}" Data="{StaticResource Icon.Trash}"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                        <Grid Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource Caption}" Text="参数" Margin="2,0,0,5"/>
                                                <TextBox x:Name="ArgsBox" Style="{StaticResource CodeBox}" Height="90"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Style="{StaticResource Caption}" Text="结果" Margin="2,0,0,5"/>
                                                <TextBox x:Name="ResultBox" Style="{StaticResource CodeBox}" Height="90"/>
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Style="{StaticResource Caption}" Text="备注（AI 查看历史时会读到）" Margin="2,8,0,5"/>
                                        <TextBox x:Name="NoteEdit" Style="{StaticResource EditBox}" Padding="10,6" MaxLength="1000" LostKeyboardFocus="NoteEdit_LostFocus"
                                                 KeyDown="NoteEdit_KeyDown"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <TextBlock x:Name="DetailEmpty" Text="选择左侧的一项查看详情" FontSize="12.5" Foreground="{StaticResource TextTertiary}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ========== 底部设置 ========== -->
                <Grid Grid.Row="3" Margin="4,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <CheckBox x:Name="RecordSwitch" Style="{StaticResource SwitchSafe}" VerticalAlignment="Center" Click="Setting_Changed"/>
                        <TextBlock Text="记录操作历史" FontSize="12.5" VerticalAlignment="Center" Margin="8,0,24,0"/>
                        <TextBlock Text="AI 能否查看记录在主界面「权限」中设置" FontSize="11.5" Foreground="{StaticResource TextTertiary}"
                                   VerticalAlignment="Center" Margin="0,0,24,0"/>
                        <TextBlock Text="保留" FontSize="12.5" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <Border Background="#E9E9EE" CornerRadius="8">
                            <StackPanel x:Name="KeepGroup" Orientation="Horizontal">
                                <RadioButton Style="{StaticResource Segment}" GroupName="Keep" Content="7 天" Tag="7" Click="Keep_Click"/>
                                <RadioButton Style="{StaticResource Segment}" GroupName="Keep" Content="30 天" Tag="30" Click="Keep_Click"/>
                                <RadioButton Style="{StaticResource Segment}" GroupName="Keep" Content="90 天" Tag="90" Click="Keep_Click"/>
                                <RadioButton Style="{StaticResource Segment}" GroupName="Keep" Content="永久" Tag="0" Click="Keep_Click"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="SettingHint" Text="开关修改后，重新启动服务生效" FontSize="11.5" Foreground="{StaticResource TextTertiary}"
                                   VerticalAlignment="Center" Margin="0,0,12,0" Visibility="Collapsed"/>
                        <Button x:Name="BtnDataDir" Style="{StaticResource SecondaryButton}" Content="数据文件夹" Margin="0,0,8,0" Click="DataDir_Click"/>
                        <Button Style="{StaticResource SecondaryButton}" Content="清空历史" Click="ClearAll_Click"/>
                    </StackPanel>
                </Grid>
            </Grid>
</UserControl>
