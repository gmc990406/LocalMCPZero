<Window x:Class="ZERO.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ZERO" Width="960" Height="740" MinWidth="860" MinHeight="660"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResize" WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource UiFont}" Icon="Resources/app.ico"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="46" ResizeBorderThickness="10" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Border x:Name="Shell" Margin="12" CornerRadius="12" Background="{StaticResource WindowBg}"
            BorderBrush="#33000000" BorderThickness="0.8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Direction="270" Opacity="0.28" Color="#000000"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ========== 标题栏 ========== -->
            <Border Grid.Row="0" CornerRadius="12,12,0,0" Background="#EFEFF2" BorderBrush="#E0E0E5" BorderThickness="0,0,0,1">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0"
                                WindowChrome.IsHitTestVisibleInChrome="True" Background="Transparent">
                        <Button x:Name="BtnClose" Style="{StaticResource TrafficLight}" Background="#FF5F57" Click="BtnClose_Click"/>
                        <Button x:Name="BtnMin" Style="{StaticResource TrafficLight}" Background="#FEBC2E" Click="BtnMin_Click"/>
                        <Button x:Name="BtnMax" Style="{StaticResource TrafficLight}" Background="#28C840" Click="BtnMax_Click"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Image Source="Resources/app.ico" Width="16" Height="16" Margin="0,0,8,0"/>
                        <TextBlock Text="ZERO" FontSize="13" FontWeight="SemiBold" Foreground="#3A3A3C"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ========== 主体 ========== -->
            <Grid Grid.Row="1" Margin="22,18,22,22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 状态卡片 -->
                <Border Grid.Row="0" Style="{StaticResource Card}" Padding="20,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid Width="44" Height="44" VerticalAlignment="Center">
                            <Ellipse x:Name="StatusHalo" Fill="#C7C7CC" Opacity="0.25"/>
                            <!-- 品牌标志：Z 字 + 两端连接点 -->
                            <Path x:Name="StatusArc" Data="M16,15 L29,15 L15,29 L28,29" Stroke="#C7C7CC" StrokeThickness="3.4"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                            <Path x:Name="StatusDots" Fill="#C7C7CC"
                                  Data="M10,15 A2.6,2.6 0 1 0 15.2,15 A2.6,2.6 0 1 0 10,15 Z M28.8,29 A2.6,2.6 0 1 0 34,29 A2.6,2.6 0 1 0 28.8,29 Z"/>
                        </Grid>
                        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="StatusTitle" Text="已停止" FontSize="17" FontWeight="SemiBold"/>
                            <TextBlock x:Name="StatusSub" Text="选择访问模式后点击「启动」" FontSize="12.5"
                                       Foreground="{StaticResource TextSecondary}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BtnMemory" Style="{StaticResource SecondaryButton}" Padding="14,8" FontSize="13"
                                VerticalAlignment="Center" Margin="0,0,10,0" Click="BtnMemory_Click"
                                ToolTip="查看和编辑 AI 共享的长期记忆">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource IconPath}" Width="13" Height="13" Margin="0,0,7,0" Data="{StaticResource IcoMemory}"/>
                                <TextBlock Text="记忆库"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnHistory" Style="{StaticResource SecondaryButton}" Padding="14,8" FontSize="13"
                                VerticalAlignment="Center" Margin="0,0,10,0" Click="BtnHistory_Click"
                                ToolTip="查看 AI 在这台电脑上的操作记录">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource IconPath}" Width="13" Height="13" Margin="0,0,7,0" Data="{StaticResource IcoHistory}"/>
                                <TextBlock Text="历史记录"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnToggle" Style="{StaticResource PrimaryButton}" MinWidth="110"
                                VerticalAlignment="Center" Click="BtnToggle_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path x:Name="ToggleIcon" Width="11" Height="11" Stretch="Uniform" Fill="White" Stroke="White" StrokeThickness="1.5"
                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      VerticalAlignment="Center" Margin="0,1,8,0" Data="{StaticResource IcoPlay}"/>
                                <TextBlock x:Name="ToggleText" Text="启动" Foreground="White" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 模式 + 连接信息 -->
                <Grid Grid.Row="1" Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="5*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="6*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 访问模式 -->
                    <Border Grid.Column="0" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="访问模式" Style="{StaticResource Caption}"/>
                            <Border Background="#E9E9EE" CornerRadius="8" Margin="0,10,0,0" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="ModeRestricted" Style="{StaticResource Segment}" GroupName="Mode"
                                                 Content="有限制" Checked="Mode_Changed"/>
                                    <RadioButton x:Name="ModeFull" Style="{StaticResource Segment}" GroupName="Mode"
                                                 Content="全电脑访问" Checked="Mode_Changed"/>
                                </StackPanel>
                            </Border>
                            <Border x:Name="ModeHintBox" CornerRadius="8" Padding="12,10" Margin="0,12,0,0" Background="#EEF5FF">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Path x:Name="ModeHintIcon" Style="{StaticResource IconPath}" Width="15" Height="15" VerticalAlignment="Top"
                                          Stroke="{StaticResource Accent}" Margin="0,1,10,0" Data="{StaticResource IcoInfo}"/>
                                    <TextBlock x:Name="ModeHint" Grid.Column="1" FontSize="12" TextWrapping="Wrap" LineHeight="18"
                                               Foreground="#3A3A3C"/>
                                </Grid>
                            </Border>
                            <!-- 免确认模式（仅全电脑访问） -->
                            <Border x:Name="TrustPanel" CornerRadius="8" Padding="12,10" Margin="0,10,0,0" Background="#F5F5F7">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="免确认模式" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                                        <TextBlock x:Name="TrustHint" FontSize="11.5" TextWrapping="Wrap" LineHeight="17" Margin="0,3,0,0"
                                                   Foreground="{StaticResource TextSecondary}"/>
                                    </StackPanel>
                                    <CheckBox x:Name="TrustSwitch" Grid.Column="1" Style="{StaticResource Switch}" Margin="12,0,0,0"
                                              VerticalAlignment="Center" Checked="Trust_Changed" Unchecked="Trust_Changed"/>
                                </Grid>
                            </Border>
                            <StackPanel x:Name="WorkspacePanel" Margin="0,14,0,0">
                                <TextBlock Text="工作空间" Style="{StaticResource Caption}"/>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="WorkspaceBox" Style="{StaticResource Field}" FontFamily="{StaticResource UiFont}"/>
                                    <Button x:Name="BtnBrowse" Grid.Column="1" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                                            Height="32" Content="选择…" Click="BtnBrowse_Click"/>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 连接信息 -->
                    <Border Grid.Column="2" Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="连接信息" Style="{StaticResource Caption}"/>
                                <TextBlock x:Name="CopiedTip" Text="已复制" FontSize="11.5" Foreground="{StaticResource Green}"
                                           HorizontalAlignment="Right" Opacity="0" FontWeight="SemiBold"/>
                            </Grid>

                            <TextBlock Text="公网地址" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,12,0,6"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="UrlBox" Style="{StaticResource Field}"/>
                                <Button x:Name="EyeUrl" Grid.Column="1" Style="{StaticResource IconButton}" Margin="4,0,0,0"
                                        ToolTip="显示 / 隐藏" Click="EyeUrl_Click"/>
                                <Button x:Name="CopyUrl" Grid.Column="2" Style="{StaticResource IconButton}"
                                        ToolTip="复制" Click="CopyUrl_Click">
                                    <Path Style="{StaticResource IconPath}" Data="{StaticResource IcoCopy}"/>
                                </Button>
                                <!-- 占位，与 Token 行的「重新生成」按钮对齐 -->
                                <Border Grid.Column="3" Width="{Binding ActualWidth, ElementName=RegenToken}"/>
                            </Grid>

                            <TextBlock Text="Token" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,12,0,6"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TokenBox" Style="{StaticResource Field}"/>
                                <Button x:Name="EyeToken" Grid.Column="1" Style="{StaticResource IconButton}" Margin="4,0,0,0"
                                        ToolTip="显示 / 隐藏" Click="EyeToken_Click"/>
                                <Button x:Name="CopyToken" Grid.Column="2" Style="{StaticResource IconButton}"
                                        ToolTip="复制" Click="CopyToken_Click">
                                    <Path Style="{StaticResource IconPath}" Data="{StaticResource IcoCopy}"/>
                                </Button>
                                <Button x:Name="RegenToken" Grid.Column="3" Style="{StaticResource IconButton}"
                                        ToolTip="重新生成 Token" Click="RegenToken_Click">
                                    <Path Style="{StaticResource IconPath}" Data="{StaticResource IcoRefresh}"/>
                                </Button>
                            </Grid>

                            <TextBlock Text="MCP 地址（填入 AI 客户端）" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,12,0,6"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="McpBox" Style="{StaticResource Field}"/>
                                <Button x:Name="EyeMcp" Grid.Column="1" Style="{StaticResource IconButton}" Margin="4,0,0,0"
                                        ToolTip="显示 / 隐藏" Click="EyeMcp_Click"/>
                                <Button x:Name="CopyMcp" Grid.Column="2" Style="{StaticResource IconButton}"
                                        ToolTip="复制" Click="CopyMcp_Click">
                                    <Path Style="{StaticResource IconPath}" Data="{StaticResource IcoCopy}"/>
                                </Button>
                                <!-- 占位，与 Token 行的「重新生成」按钮对齐 -->
                                <Border Grid.Column="3" Width="{Binding ActualWidth, ElementName=RegenToken}"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 日志 -->
                <Grid Grid.Row="2" Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{StaticResource LogBg}" CornerRadius="12" Effect="{StaticResource CardShadow}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="38"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border CornerRadius="12,12,0,0" Background="#2C2C2E" BorderBrush="#3A3A3C" BorderThickness="0,0,0,1">
                                <Grid Margin="14,0,8,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse x:Name="ServerDot" Width="8" Height="8" Fill="#636366" Margin="0,0,9,0"/>
                                        <TextBlock Text="MCP 服务" Foreground="#E5E5EA" FontSize="12" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="ServerState" Text="未运行" Foreground="#8E8E93" FontSize="11.5" Margin="8,0,0,0"/>
                                    </StackPanel>
                                    <Button HorizontalAlignment="Right" Style="{StaticResource IconButton}" Foreground="#8E8E93" x:Name="ClearServerBtn" ToolTip="清空" Click="ClearServerLog_Click">
                                        <Path Style="{StaticResource IconPath}" Width="13" Height="13" Data="{StaticResource IcoTrash}"/>
                                    </Button>
                                </Grid>
                            </Border>
                            <TextBox x:Name="ServerLog" Grid.Row="1" Style="{StaticResource LogBox}" Margin="12,8,6,10"/>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Background="{StaticResource LogBg}" CornerRadius="12" Effect="{StaticResource CardShadow}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="38"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border CornerRadius="12,12,0,0" Background="#2C2C2E" BorderBrush="#3A3A3C" BorderThickness="0,0,0,1">
                                <Grid Margin="14,0,8,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse x:Name="TunnelDot" Width="8" Height="8" Fill="#636366" Margin="0,0,9,0"/>
                                        <TextBlock Text="Cloudflare 隧道" Foreground="#E5E5EA" FontSize="12" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="TunnelState" Text="未运行" Foreground="#8E8E93" FontSize="11.5" Margin="8,0,0,0"/>
                                    </StackPanel>
                                    <Button HorizontalAlignment="Right" Style="{StaticResource IconButton}" Foreground="#8E8E93" x:Name="ClearTunnelBtn" ToolTip="清空" Click="ClearTunnelLog_Click">
                                        <Path Style="{StaticResource IconPath}" Width="13" Height="13" Data="{StaticResource IcoTrash}"/>
                                    </Button>
                                </Grid>
                            </Border>
                            <TextBox x:Name="TunnelLog" Grid.Row="1" Style="{StaticResource LogBox}" Margin="12,8,6,10"/>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- ========== 环境准备遮罩（等待框） ========== -->
            <Grid x:Name="SetupOverlay" Grid.RowSpan="2" Visibility="Collapsed">
                <Border CornerRadius="12" Background="#66F5F5F7"/>
                <Border Background="#59000000" CornerRadius="12"/>
                <Border Width="440" Background="White" CornerRadius="14" Padding="28,26" VerticalAlignment="Center"
                        HorizontalAlignment="Center">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="40" ShadowDepth="8" Direction="270" Opacity="0.3"/>
                    </Border.Effect>
                    <StackPanel>
                        <Grid HorizontalAlignment="Center" Width="46" Height="46">
                            <Ellipse Stroke="#E5E5EA" StrokeThickness="4"/>
                            <Path x:Name="Spinner" Stroke="{StaticResource Accent}" StrokeThickness="4" StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" Data="M 23,2 A 21,21 0 0 1 44,23" RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform>
                                    <RotateTransform x:Name="SpinnerRotate"/>
                                </Path.RenderTransform>
                            </Path>
                            <Path x:Name="SetupDoneIcon" Style="{StaticResource IconPath}" Width="18" Height="18" StrokeThickness="2.4"
                                  Stroke="{StaticResource Red}" Data="{StaticResource IcoClose}" Visibility="Collapsed"/>
                        </Grid>
                        <TextBlock x:Name="SetupTitle" Text="正在准备运行环境" FontSize="16" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Margin="0,16,0,4"/>
                        <TextBlock Text="首次运行需要下载组件，全部安装在软件目录内，不改动系统" FontSize="12"
                                   Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" TextWrapping="Wrap"
                                   TextAlignment="Center"/>

                        <StackPanel x:Name="StepList" Margin="6,20,6,0"/>

                        <Grid Margin="0,16,0,0" Height="6">
                            <Border CornerRadius="3" Background="#E9E9EE"/>
                            <Border x:Name="ProgressFill" CornerRadius="3" Background="{StaticResource Accent}" HorizontalAlignment="Left" Width="0"/>
                        </Grid>
                        <TextBlock x:Name="SetupDetail" Text="" FontSize="11.5" Foreground="{StaticResource TextTertiary}"
                                   Margin="0,10,0,0" TextTrimming="CharacterEllipsis" FontFamily="{StaticResource MonoFont}"/>

                        <StackPanel x:Name="SetupButtons" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0"
                                    Visibility="Collapsed">
                            <Button Style="{StaticResource SecondaryButton}" Content="打开日志" Padding="16,6" Margin="0,0,10,0" Click="SetupOpenLog_Click"/>
                            <Button Style="{StaticResource SecondaryButton}" Content="退出" Padding="16,6" Click="SetupExit_Click"/>
                            <Button Style="{StaticResource PrimaryButton}" Content="重试" Padding="20,6" Margin="10,0,0,0"
                                    Click="SetupRetry_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
