<UserControl x:Class="ZERO.MemoryWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ZERO"
             FontFamily="{StaticResource UiFont}"
             UseLayoutRounding="True" SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType">
    <UserControl.Resources>

        <BooleanToVisibilityConverter x:Key="BoolVis"/>

        <DataTemplate x:Key="MemTemplate">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding FirstLine}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <Path Grid.Column="1" Style="{StaticResource IconPresenter}" Width="12" Height="12" Margin="8,0,0,0"
                          Stroke="{StaticResource Accent}" Data="{StaticResource Icon.Pin}"
                          Visibility="{Binding Pinned, Converter={StaticResource BoolVis}}"/>
                </Grid>
                <TextBlock Text="{Binding Tags}" FontSize="11.5" Foreground="{StaticResource Accent}" Margin="0,3,0,0"
                           TextTrimming="CharacterEllipsis" Visibility="{Binding HasTags, Converter={StaticResource BoolVis}}"/>
                <TextBlock Text="{Binding Meta}" FontSize="11.5" Foreground="{StaticResource TextSecondary}" Margin="0,3,0,0"
                           TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>
<Grid Margin="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid x:Name="PageHead" Grid.Row="0" Margin="0,0,0,14">
                    <TextBlock x:Name="PageTitle" Text="记忆库" FontWeight="SemiBold"
                               FontSize="{DynamicResource PageTitleFontSize}" VerticalAlignment="Center"/>
                </Grid>


                <!-- ========== 工具栏 ========== -->
                <Grid Grid.Row="1" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Style="{StaticResource PrimaryButton}" Padding="14,7" Click="New_Click">
                        <TextBlock Text="＋ 新建记忆" Foreground="White" FontWeight="SemiBold"/>
                    </Button>
                    <local:SearchBar x:Name="Search" Grid.Column="1" Margin="14,0,0,0"
                                     Hint="搜索记忆内容、标签、来源…"
                                     QueryChanged="Search_Changed" SearchRequested="Search_Go" Cleared="Search_Go"/>
                    <Button x:Name="BtnTagFilter" Grid.Column="2" Style="{StaticResource SecondaryButton}"
                            Content="标签" Padding="12,6" Margin="8,0,0,0" Click="TagFilter_Click"/>
                    <Popup x:Name="TagPopup" PlacementTarget="{Binding ElementName=BtnTagFilter}" Placement="Bottom"
                           StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                        <Border Background="White" BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                                CornerRadius="10" Padding="10" Width="280" MaxHeight="360"
                                Effect="{StaticResource CardShadow}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBox x:Name="TagSearchBox" Style="{StaticResource EditBox}" Padding="10,6"
                                         TextChanged="TagSearch_Changed"/>
                                <TextBlock x:Name="TagSearchHint" Text="过滤标签…" FontSize="12" Foreground="{StaticResource TextTertiary}"
                                           Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                <Button Grid.Row="1" Style="{StaticResource SecondaryButton}" Content="清除筛选"
                                        HorizontalAlignment="Left" Margin="0,8,0,8" Padding="10,4" Click="ClearTags_Click"/>
                                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" MaxHeight="260">
                                    <StackPanel x:Name="TagPopupList"/>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Popup>
                    <Button Grid.Column="3" Style="{StaticResource IconButton}" ToolTip="刷新" Margin="6,0,0,0" Click="Refresh_Click">
                        <Path Style="{StaticResource IconPresenter}" Data="{StaticResource Icon.Refresh}"/>
                    </Button>
                </Grid>

                <!-- 已选标签 chip（最多一行） -->
                <StackPanel x:Name="SelectedTagRow" Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,12" Visibility="Collapsed">
                    <WrapPanel x:Name="SelectedTagChips" MaxHeight="28"/>
                    <Button x:Name="BtnMoreTags" Style="{StaticResource SecondaryButton}" Content="+0" Padding="8,2"
                            Margin="4,0,0,0" Visibility="Collapsed" Click="TagFilter_Click"/>
                </StackPanel>

                <!-- ========== 主体 ========== -->
                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="ListCol" Width="300"/>
                        <ColumnDefinition x:Name="ListGap" Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource Card}" Padding="8,12,4,8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="ListTitle" Style="{StaticResource Caption}" Text="记忆" Margin="12,0,0,8"/>
                            <ListBox x:Name="MainList" Grid.Row="1" Style="{StaticResource PlainList}" SelectionChanged="MainList_SelectionChanged"
                                     ItemTemplate="{StaticResource MemTemplate}"/>
                            <TextBlock x:Name="ListEmpty" Grid.Row="1" TextAlignment="Center" FontSize="12.5" LineHeight="20"
                                       Foreground="{StaticResource TextTertiary}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="Collapsed"/>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20,16,16,16">
                        <Grid>
                            <Grid x:Name="Detail" Visibility="Collapsed">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="DetailTitle" FontSize="16" FontWeight="SemiBold"/>
                                            <TextBlock x:Name="SavedTip" Text="已保存" FontSize="11.5" Foreground="{StaticResource Green}"
                                                       VerticalAlignment="Center" Margin="10,2,0,0" Opacity="0"/>
                                        </StackPanel>
                                        <TextBlock x:Name="MetaText" FontSize="11.5" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <StackPanel x:Name="MemActions" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="10,0,0,0">
                                        <Button x:Name="BtnPin" Style="{StaticResource IconButton}" Click="Pin_Click">
                                            <Path x:Name="PinIcon" Style="{StaticResource IconPresenter}" Data="{StaticResource Icon.Pin}"/>
                                        </Button>
                                        <Button x:Name="BtnProtect" Style="{StaticResource IconButton}" Click="Protect_Click">
                                            <Path x:Name="ProtectIcon" Style="{StaticResource IconPresenter}" Data="{StaticResource Icon.Lock}"/>
                                        </Button>
                                        <Button Style="{StaticResource IconButton}" ToolTip="移到回收站（可在治理中心恢复）" Click="Delete_Click">
                                            <Path Style="{StaticResource IconPresenter}" Data="{StaticResource Icon.Trash}"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <Grid Grid.Row="1">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Style="{StaticResource Caption}" Text="内容（AI 搜索记忆时会读到；每条只写一件事）" Margin="2,0,0,6"/>
                                    <TextBox x:Name="ContentEdit" Grid.Row="1" Style="{StaticResource EditBox}" AcceptsReturn="True" TextWrapping="Wrap"
                                             VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" MaxLength="2000"
                                             LostKeyboardFocus="Edit_LostFocus"/>
                                    <TextBlock x:Name="ContentHint" Grid.Row="1" Text="例如：用户希望回答和代码注释都使用中文"
                                               FontSize="12.5" Foreground="{StaticResource TextTertiary}" Margin="12,9,0,0" IsHitTestVisible="False"/>
                                </Grid>

                                <StackPanel Grid.Row="2" Margin="0,14,0,0">
                                    <TextBlock Style="{StaticResource Caption}" Text="标签（用逗号分隔，方便筛选和搜索）" Margin="2,0,0,6"/>
                                    <TextBox x:Name="TagsEdit" Style="{StaticResource EditBox}" MaxLength="300" LostKeyboardFocus="Edit_LostFocus"
                                             KeyDown="TagsEdit_KeyDown"/>
                                </StackPanel>

                                <StackPanel Grid.Row="3" Margin="0,14,0,0" Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Caption}" Text="哪些模式下的 AI 可以看到" VerticalAlignment="Center" Margin="2,0,12,0"/>
                                    <Border Background="#E9E9EE" CornerRadius="8">
                                        <StackPanel x:Name="ScopeGroup" Orientation="Horizontal">
                                            <RadioButton Style="{StaticResource Segment}" GroupName="Scope" Content="所有模式" Tag="all" Click="Scope_Click"/>
                                            <RadioButton Style="{StaticResource Segment}" GroupName="Scope" Content="仅全电脑访问" Tag="full" Click="Scope_Click"/>
                                            <RadioButton Style="{StaticResource Segment}" GroupName="Scope" Content="仅有限制模式" Tag="restricted" Click="Scope_Click"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                            <TextBlock x:Name="DetailEmpty" Text="选择左侧的一条记忆查看和编辑&#x0a;或点击「新建记忆」手动添加" TextAlignment="Center" FontSize="12.5"
                                       LineHeight="20" Foreground="{StaticResource TextTertiary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ========== 底部设置 ========== -->
                <Grid Grid.Row="4" Margin="4,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <CheckBox x:Name="EnableSwitch" Style="{StaticResource SwitchSafe}" VerticalAlignment="Center" Click="Setting_Changed"/>
                        <TextBlock Text="启用记忆库" FontSize="12.5" VerticalAlignment="Center" Margin="8,0,24,0"
                                   ToolTip="关闭后 AI 看不到也无法使用记忆库（已有记忆会保留）"/>
                        <TextBlock Text="AI 能否保存和修改记忆在主界面「权限」中设置 · 置顶的记忆会在 AI 连接时直接告诉它 · 历史版本和回收站在「治理」中" FontSize="11.5" Foreground="{StaticResource TextTertiary}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="SettingHint" Text="开关修改后，重新启动服务生效" FontSize="11.5" Foreground="{StaticResource TextTertiary}"
                                   VerticalAlignment="Center" Margin="0,0,12,0" Visibility="Collapsed"/>
                        <Button x:Name="BtnDataDir" Style="{StaticResource SecondaryButton}" Content="数据文件夹" Click="DataDir_Click"/>
                    </StackPanel>
                </Grid>
            </Grid>
</UserControl>
