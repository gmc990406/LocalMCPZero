<UserControl x:Class="ZERO.PermissionWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource UiFont}"
             UseLayoutRounding="True" SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType">
<Grid Margin="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid x:Name="PageHead" Grid.Row="0" Margin="0,0,0,14">
                    <TextBlock x:Name="PageTitle" Text="权限" FontWeight="SemiBold"
                               FontSize="{DynamicResource PageTitleFontSize}" VerticalAlignment="Center"/>
                </Grid>


                <!-- ========== 模式切换 ========== -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Background="#E9E9EE" CornerRadius="8" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="TabRestricted" Style="{StaticResource Segment}" GroupName="PermMode"
                                         Content="有限制" Checked="Tab_Changed"/>
                            <RadioButton x:Name="TabFull" Style="{StaticResource Segment}" GroupName="PermMode"
                                         Content="全电脑访问" Checked="Tab_Changed"/>
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="CountText" Grid.Column="1" FontSize="12" Foreground="{StaticResource TextSecondary}"
                               VerticalAlignment="Center" HorizontalAlignment="Right"/>
                </Grid>

                <Border x:Name="ModeBox" Grid.Row="2" CornerRadius="8" Padding="12,10" Margin="0,12,0,4" Background="#EEF5FF">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Path x:Name="ModeIcon" Style="{StaticResource IconPresenter}" Width="15" Height="15" VerticalAlignment="Top"
                              Margin="0,1,10,0" Data="{StaticResource Icon.Info}" Stroke="{StaticResource Accent}"/>
                        <TextBlock x:Name="ModeText" Grid.Column="1" FontSize="12" TextWrapping="Wrap" LineHeight="18"
                                   Foreground="{StaticResource TextPrimary}"/>
                    </Grid>
                </Border>

                <!-- ========== 权限列表（代码生成） ========== -->
                <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Margin="0,4,-10,0" Padding="0,0,10,0">
                    <Grid x:Name="RowsHost" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition x:Name="PermGapCol" Width="0"/>
                            <ColumnDefinition x:Name="PermCol1Def" Width="0"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel x:Name="PermCol0"/>
                        <StackPanel x:Name="PermCol1" Grid.Column="2"/>
                    </Grid>
                </ScrollViewer>

                <!-- ========== 底部 ========== -->
                <Grid Grid.Row="4" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Style="{StaticResource SecondaryButton}" Content="恢复默认" Click="Reset_Click"
                            ToolTip="把当前模式的权限恢复为默认设置"/>
                    <TextBlock x:Name="FooterHint" Grid.Column="1" FontSize="11.5" Foreground="{StaticResource TextTertiary}"
                               TextWrapping="Wrap" LineHeight="17" VerticalAlignment="Center" Margin="14,0,14,0"/>
                    <Button x:Name="BtnApply" Grid.Column="2" Style="{StaticResource PrimaryButton}" Padding="16,7"
                            Click="Apply_Click" Visibility="Collapsed">
                        <TextBlock Text="重启服务使其生效" Foreground="White" FontWeight="SemiBold"/>
                    </Button>
                </Grid>
            </Grid>
</UserControl>
