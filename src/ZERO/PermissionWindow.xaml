<Window x:Class="ZERO.PermissionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ZERO 权限" Width="760" Height="820" MinWidth="640" MinHeight="560"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResize" WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource UiFont}" Icon="Resources/app.ico"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="46" ResizeBorderThickness="10" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Border x:Name="Shell" Margin="12" CornerRadius="12" Background="{StaticResource WindowBg}"
            BorderBrush="#33000000" BorderThickness="0.8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Direction="270" Opacity="0.28" Color="#000000"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ========== 标题栏 ========== -->
            <Border Grid.Row="0" CornerRadius="12,12,0,0" Background="#EFEFF2" BorderBrush="#E0E0E5" BorderThickness="0,0,0,1">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0"
                                WindowChrome.IsHitTestVisibleInChrome="True" Background="Transparent">
                        <Button Style="{StaticResource TrafficLight}" Background="#FF5F57" Click="BtnClose_Click"/>
                        <Button Style="{StaticResource TrafficLight}" Background="#FEBC2E" Click="BtnMin_Click"/>
                        <Button Style="{StaticResource TrafficLight}" Background="#28C840" Click="BtnMax_Click"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Image Source="Resources/app.ico" Width="16" Height="16" Margin="0,0,8,0"/>
                        <TextBlock Text="权限" FontSize="13" FontWeight="SemiBold" Foreground="#3A3A3C"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="22,16,22,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ========== 模式切换 ========== -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Background="#E9E9EE" CornerRadius="8" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="TabRestricted" Style="{StaticResource Segment}" GroupName="PermMode"
                                         Content="有限制" Checked="Tab_Changed"/>
                            <RadioButton x:Name="TabFull" Style="{StaticResource Segment}" GroupName="PermMode"
                                         Content="全电脑访问" Checked="Tab_Changed"/>
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="CountText" Grid.Column="1" FontSize="12" Foreground="{StaticResource TextSecondary}"
                               VerticalAlignment="Center" HorizontalAlignment="Right"/>
                </Grid>

                <Border x:Name="ModeBox" Grid.Row="1" CornerRadius="8" Padding="12,10" Margin="0,12,0,4" Background="#EEF5FF">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Path x:Name="ModeIcon" Style="{StaticResource IconPath}" Width="15" Height="15" VerticalAlignment="Top"
                              Margin="0,1,10,0" Data="{StaticResource IcoInfo}" Stroke="{StaticResource Accent}"/>
                        <TextBlock x:Name="ModeText" Grid.Column="1" FontSize="12" TextWrapping="Wrap" LineHeight="18"
                                   Foreground="{StaticResource TextPrimary}"/>
                    </Grid>
                </Border>

                <!-- ========== 权限列表（代码生成） ========== -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,4,-10,0" Padding="0,0,10,0">
                    <StackPanel x:Name="RowsHost" Margin="0,0,0,8"/>
                </ScrollViewer>

                <!-- ========== 底部 ========== -->
                <Grid Grid.Row="3" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Style="{StaticResource SecondaryButton}" Content="恢复默认" Click="Reset_Click"
                            ToolTip="把当前模式的权限恢复为默认设置"/>
                    <TextBlock x:Name="FooterHint" Grid.Column="1" FontSize="11.5" Foreground="{StaticResource TextTertiary}"
                               TextWrapping="Wrap" LineHeight="17" VerticalAlignment="Center" Margin="14,0,14,0"/>
                    <Button x:Name="BtnApply" Grid.Column="2" Style="{StaticResource PrimaryButton}" Padding="16,7"
                            Click="Apply_Click" Visibility="Collapsed">
                        <TextBlock Text="重启服务使其生效" Foreground="White" FontWeight="SemiBold"/>
                    </Button>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
