<Window x:Class="ZERO.VisionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ZERO 视觉工作台" Width="1120" Height="800" MinWidth="940" MinHeight="640"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResize" WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource UiFont}" Icon="Resources/app.ico"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="46" ResizeBorderThickness="10" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <DataTemplate x:Key="WinTemplate">
            <StackPanel>
                <TextBlock Text="{Binding Line}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding Meta}" FontSize="11.5" Foreground="{StaticResource TextSecondary}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="LineTemplate">
            <TextBlock Text="{Binding Line}" FontSize="11.5" FontFamily="{StaticResource MonoFont}" TextWrapping="Wrap"/>
        </DataTemplate>
    </Window.Resources>

    <Border x:Name="Shell" Margin="12" CornerRadius="12" Background="{StaticResource WindowBg}" BorderBrush="#33000000" BorderThickness="0.8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Direction="270" Opacity="0.28" Color="#000000"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" CornerRadius="12,12,0,0" Background="#EFEFF2" BorderBrush="#E0E0E5" BorderThickness="0,0,0,1">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0"
                                WindowChrome.IsHitTestVisibleInChrome="True" Background="Transparent">
                        <Button Style="{StaticResource TrafficLight}" Background="#FF5F57" Click="BtnClose_Click"/>
                        <Button Style="{StaticResource TrafficLight}" Background="#FEBC2E" Click="BtnMin_Click"/>
                        <Button Style="{StaticResource TrafficLight}" Background="#28C840" Click="BtnMax_Click"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Image Source="Resources/app.ico" Width="16" Height="16" Margin="0,0,8,0"/>
                        <TextBlock Text="视觉工作台" FontSize="13" FontWeight="SemiBold" Foreground="#3A3A3C"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="22,16,22,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 工具栏：紧急停止 + 状态 -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="BtnStop" Style="{StaticResource PrimaryButton}" Background="{StaticResource Red}" Padding="16,7" Click="Stop_Click"
                            ToolTip="立即拒绝所有界面和网页操作，撤销全部窗口授权">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="11" Height="11" Stretch="Uniform" Fill="White" Stroke="White" StrokeThickness="1.5" Margin="0,1,8,0"
                                  VerticalAlignment="Center" Data="{StaticResource IcoStop}"/>
                            <TextBlock x:Name="StopText" Text="紧急停止" Foreground="White" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                    <TextBlock x:Name="StatusText" Grid.Column="1" FontSize="12" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"
                               Margin="14,0,0,0" TextWrapping="Wrap"/>
                    <Button Grid.Column="2" Style="{StaticResource IconButton}" ToolTip="刷新" Click="Refresh_Click">
                        <Path Style="{StaticResource IconPath}" Data="{StaticResource IcoRefresh}"/>
                    </Button>
                </Grid>

                <!-- 待批准的请求 -->
                <StackPanel x:Name="RequestsHost" Grid.Row="1"/>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="310"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}" Padding="8,12,4,8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Margin="8,0,8,8">
                                <TextBox x:Name="FilterBox" Style="{StaticResource EditBox}" Padding="30,6,8,6" TextChanged="Filter_Changed"/>
                                <Path Style="{StaticResource IconPath}" Stroke="{StaticResource TextTertiary}" Width="12" Height="12" HorizontalAlignment="Left"
                                      Margin="11,0,0,0" Data="{StaticResource IcoSearch}" IsHitTestVisible="False"/>
                                <TextBlock x:Name="FilterHint" Text="筛选窗口标题或进程…" FontSize="12" Foreground="{StaticResource TextTertiary}"
                                           VerticalAlignment="Center" Margin="31,0,0,0" IsHitTestVisible="False"/>
                            </Grid>
                            <ListBox x:Name="WinList" Grid.Row="1" Style="{StaticResource PlainList}" ItemTemplate="{StaticResource WinTemplate}"
                                     SelectionChanged="WinList_SelectionChanged"/>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="18,14,16,14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="WinTitle" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="选择左侧的窗口"/>
                                <TextBlock x:Name="WinMeta" FontSize="11.5" Foreground="{StaticResource TextSecondary}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <WrapPanel x:Name="WinButtons" Grid.Row="1" Margin="0,10,0,0"/>
                            <Border Grid.Row="2" Background="#E9E9EE" CornerRadius="8" HorizontalAlignment="Left" Margin="0,4,0,10">
                                <StackPanel x:Name="ViewBar" Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource Segment}" GroupName="View" Content="画面" Tag="shot" IsChecked="True" Click="View_Click"/>
                                    <RadioButton Style="{StaticResource Segment}" GroupName="View" Content="控件树" Tag="tree" Click="View_Click"/>
                                    <RadioButton Style="{StaticResource Segment}" GroupName="View" Content="授权记录" Tag="grants" Click="View_Click"/>
                                    <RadioButton Style="{StaticResource Segment}" GroupName="View" Content="操作日志" Tag="log" Click="View_Click"/>
                                </StackPanel>
                            </Border>
                            <Grid Grid.Row="3">
                                <Border x:Name="ShotBox" Background="#F4F4F7" CornerRadius="8">
                                    <Grid>
                                        <Image x:Name="Shot" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" Margin="6"/>
                                        <TextBlock x:Name="ShotHint" TextAlignment="Center" FontSize="12.5" LineHeight="20" Foreground="{StaticResource TextTertiary}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Margin="20"/>
                                    </Grid>
                                </Border>
                                <ListBox x:Name="TreeList" Style="{StaticResource PlainList}" Visibility="Collapsed">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" FontSize="11.5" FontFamily="{StaticResource MonoFont}" TextTrimming="CharacterEllipsis"/>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <ScrollViewer x:Name="GrantsView" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                                    <StackPanel x:Name="GrantsHost"/>
                                </ScrollViewer>
                                <ListBox x:Name="LogList" Style="{StaticResource PlainList}" ItemTemplate="{StaticResource LineTemplate}" Visibility="Collapsed"/>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <TextBlock x:Name="FooterHint" Grid.Row="3" Margin="4,12,0,0" FontSize="11.5" Foreground="{StaticResource TextTertiary}" TextWrapping="Wrap"
                           Text="AI 可以观察窗口（需要「查看窗口和控件」「窗口截图和录制」权限）；操作窗口还需要「操作窗口控件」权限，并且只能操作你在这里授权的窗口。登录、UAC 等安全窗口和 ZERO 主程序自己的窗口始终禁止。"/>
            </Grid>
        </Grid>
    </Border>
</Window>
