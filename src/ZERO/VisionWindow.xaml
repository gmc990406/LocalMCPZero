<UserControl x:Class="ZERO.VisionWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource UiFont}"
             UseLayoutRounding="True" SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType">
    <UserControl.Resources>

        <DataTemplate x:Key="WinTemplate">
            <StackPanel>
                <TextBlock Text="{Binding Line}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding Meta}" FontSize="11.5" Foreground="{StaticResource TextSecondary}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="LineTemplate">
            <TextBlock Text="{Binding Line}" FontSize="11.5" FontFamily="{StaticResource MonoFont}" TextWrapping="Wrap"/>
        </DataTemplate>
    </UserControl.Resources>
<Grid Margin="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid x:Name="PageHead" Grid.Row="0" Margin="0,0,0,14">
                    <TextBlock x:Name="PageTitle" Text="视觉工作台" FontWeight="SemiBold"
                               FontSize="{DynamicResource PageTitleFontSize}" VerticalAlignment="Center"/>
                </Grid>


                <!-- 工具栏：紧急停止 + 状态 -->
                <Grid Grid.Row="1" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="BtnStop" Style="{StaticResource PrimaryButton}" Background="{StaticResource Red}" Padding="16,7" Click="Stop_Click"
                            ToolTip="立即拒绝所有界面和网页操作，撤销全部窗口授权">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="11" Height="11" Stretch="Uniform" Fill="White" Stroke="White" StrokeThickness="1.5" Margin="0,1,8,0"
                                  VerticalAlignment="Center" Data="{StaticResource Icon.Stop}"/>
                            <TextBlock x:Name="StopText" Text="紧急停止" Foreground="White" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                    <TextBlock x:Name="StatusText" Grid.Column="1" FontSize="12" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"
                               Margin="14,0,0,0" TextWrapping="Wrap"/>
                    <Button Grid.Column="2" Style="{StaticResource IconButton}" ToolTip="刷新" Click="Refresh_Click">
                        <Path Style="{StaticResource IconPresenter}" Data="{StaticResource Icon.Refresh}"/>
                    </Button>
                </Grid>

                <!-- 可观测进程范围：不再逐窗口授权。全部观测为用户主动可选；受保护系统进程始终排除。 -->
                <StackPanel Grid.Row="2" Margin="0,0,0,6">
                    <Border Background="#EFF3FA" CornerRadius="8" Padding="12,9" Margin="0,0,0,8">
                        <WrapPanel VerticalAlignment="Center">
                            <TextBlock x:Name="ScopeText" FontSize="12" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="{StaticResource TextPrimary}"/>
                            <Button Content="全部观测" Style="{StaticResource SecondaryButton}" Padding="11,5" Margin="0,0,6,0" Click="ScopeAll_Click"/>
                            <Button Content="指定进程" Style="{StaticResource SecondaryButton}" Padding="11,5" Click="ScopeSelected_Click"/>
                        </WrapPanel>
                    </Border>
                    <StackPanel x:Name="RequestsHost"/>
                </StackPanel>

                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="ListCol" Width="280"/>
                        <ColumnDefinition x:Name="ListGap" Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}" Padding="8,12,4,8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Margin="8,0,8,8">
                                <TextBox x:Name="FilterBox" Style="{StaticResource EditBox}" Padding="30,6,8,6" TextChanged="Filter_Changed"/>
                                <Path Style="{StaticResource IconPresenter}" Stroke="{StaticResource TextTertiary}" Width="12" Height="12" HorizontalAlignment="Left"
                                      Margin="11,0,0,0" Data="{StaticResource Icon.Search}" IsHitTestVisible="False"/>
                                <TextBlock x:Name="FilterHint" Text="筛选窗口标题或进程…" FontSize="12" Foreground="{StaticResource TextTertiary}"
                                           VerticalAlignment="Center" Margin="31,0,0,0" IsHitTestVisible="False"/>
                            </Grid>
                            <ListBox x:Name="WinList" Grid.Row="1" Style="{StaticResource PlainList}" ItemTemplate="{StaticResource WinTemplate}"
                                     SelectionChanged="WinList_SelectionChanged"/>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="18,14,16,14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="WinTitle" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="选择左侧的窗口"/>
                                <TextBlock x:Name="WinMeta" FontSize="11.5" Foreground="{StaticResource TextSecondary}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <WrapPanel x:Name="WinButtons" Grid.Row="1" Margin="0,10,0,0"/>
                            <Border Grid.Row="2" Background="#E9E9EE" CornerRadius="8" HorizontalAlignment="Left" Margin="0,4,0,10">
                                <StackPanel x:Name="ViewBar" Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource Segment}" GroupName="View" Content="画面" Tag="shot" IsChecked="True" Click="View_Click"/>
                                    <RadioButton Style="{StaticResource Segment}" GroupName="View" Content="控件树" Tag="tree" Click="View_Click"/>
                                    <RadioButton Style="{StaticResource Segment}" GroupName="View" Content="授权记录" Tag="grants" Click="View_Click"/>
                                    <RadioButton Style="{StaticResource Segment}" GroupName="View" Content="操作日志" Tag="log" Click="View_Click"/>
                                </StackPanel>
                            </Border>
                            <Grid Grid.Row="3">
                                <Border x:Name="ShotBox" Background="{DynamicResource ShotPaneBg}" CornerRadius="12" MinHeight="{DynamicResource ShotMinHeight}">
                                    <Grid>
                                        <Image x:Name="Shot" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" Margin="6"/>
                                        <TextBlock x:Name="ShotHint" TextAlignment="Center" FontSize="12.5" LineHeight="20" Foreground="{DynamicResource ShotPaneFg}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Margin="20"/>
                                    </Grid>
                                </Border>
                                <ListBox x:Name="TreeList" Style="{StaticResource PlainList}" Visibility="Collapsed">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" FontSize="11.5" FontFamily="{StaticResource MonoFont}" TextTrimming="CharacterEllipsis"/>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <ScrollViewer x:Name="GrantsView" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                                    <StackPanel x:Name="GrantsHost"/>
                                </ScrollViewer>
                                <ListBox x:Name="LogList" Style="{StaticResource PlainList}" ItemTemplate="{StaticResource LineTemplate}" Visibility="Collapsed"/>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <TextBlock x:Name="FooterHint" Grid.Row="4" Margin="4,12,0,0" FontSize="11.5" Foreground="{StaticResource TextTertiary}" TextWrapping="Wrap"
                           Text="通过「全部观测 / 指定进程」统一控制 AI 可见范围，无需逐窗口授权；操作仍受权限总开关、紧急停止与安全窗口保护。后台优先使用 UIA，不强行置前；最小化画面可能受目标程序限制。"/>
            </Grid>
</UserControl>
